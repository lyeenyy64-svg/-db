# ===========================================================
# DEBTFLOW Backend 환경변수
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값으로 채우세요.
#   PowerShell: Copy-Item backend/.env.example backend/.env
# ===========================================================

# Slack Bot User OAuth Token (xoxb- 로 시작하는 값)
SLACK_BOT_TOKEN=xoxb-여기에-실제-토큰-붙여넣기

# 모니터링할 Slack 채널 ID (C 로 시작하는 값)
# 찾는 법: Slack에서 #입금내역_공유방 → 채널 이름 클릭 → 맨 아래 "채널 ID" 복사
SLACK_CHANNEL_ID=C여기에-실제-채널ID-붙여넣기

# 폴링 주기 (분 단위) — 권장: 5
SLACK_POLL_INTERVAL_MINUTES=5

# 카카오맵 API (채무자 위치 지도 기능용) — https://developers.kakao.com 가입 후
# 내 애플리케이션 → 애플리케이션 추가 → "앱 키"에서 아래 두 값 확인 (카드 등록 불필요)
# JavaScript 키: 지도 표시용 (프론트에 노출돼도 되는 값, 대신 카카오 콘솔에서 사용할 도메인 등록 필요)
KAKAO_MAP_APP_KEY=여기에-JavaScript-키-붙여넣기
# REST API 키: 주소→좌표 변환(지오코딩)용 — 서버에만 두고 절대 노출하지 않음
KAKAO_REST_API_KEY=여기에-REST-API-키-붙여넣기

# Outlook 플래그 → To Do List 자동등록 웹훅 검증용 비밀값 (Power Automate 플로우의
# HTTP 헤더 x-webhook-secret에 같은 값을 넣어야 함). 비워두면 검증 없이 허용.
OUTLOOK_FLAG_SECRET=여기에-임의의-긴-문자열-생성해서-붙여넣기

# 노션 데이터베이스에서 제목을 To Do List로 가져오기 위한 설정.
# NOTION_API_KEY: notion.so/my-integrations 에서 발급한 통합(Integration) 토큰(secret_로 시작).
#   각 사용자는 자신의 노션 데이터베이스 우측 상단 "..." → 연결 추가 → 이 통합을 공유해야 함.
#   (사용자별 데이터베이스는 이 통합 토큰 하나만 있으면 CMS 화면의 "노션 연결하기" 버튼으로
#   각자 등록하므로, 서버 .env에는 아래 NOTION_FLAG_DB_ID를 따로 지정하지 않아도 됨)
# NOTION_FLAG_DB_ID: (선택) 개인 연결을 아직 안 한 사용자에게 적용되는 예전 공용 "플래그 메일함"
#   데이터베이스 ID — 데이터베이스를 전체 페이지로 연 URL에서 확인 가능
#   (예: notion.so/워크스페이스명/1234567890abcdef1234567890abcdef?v=... 에서 물음표 앞 32자리 문자열).
NOTION_API_KEY=여기에-secret_로-시작하는-노션-통합-토큰-붙여넣기
NOTION_FLAG_DB_ID=여기에-노션-데이터베이스-ID-붙여넣기(선택,폴백용)

# 사용자 권한(role) 변경 시 요구하는 확인 암호 — 서버에만 두고 프론트 코드에는 절대 넣지 않음
ROLE_CHANGE_PASSCODE=여기에-확인-암호-지정

# 로그인 보안 — 2단계 인증(Slack DM 일회용 코드) 사용 여부. 기본 on.
# Slack 장애로 아무도 로그인하지 못할 때만 임시로 off 로 바꾸고 서버를 재시작하세요.
AUTH_2FA=on
# 로그인 세션 유지 시간(시간 단위, 기본 12)
AUTH_SESSION_HOURS=12

# 주민번호 등 고유식별정보 암호화 키 (64자리 hex). 지정하지 않으면 서버 PC 사용자 폴더의
# .debtflow/pii.key 파일에 자동 생성된다. 저장소·백업 폴더(OneDrive) 밖에 두고 별도로 안전하게
# 보관할 것 — 분실하면 암호화된 값은 복구할 수 없다. 파일 위치를 바꾸려면 PII_ENC_KEY_FILE=경로
# PII_ENC_KEY=
# PII_ENC_KEY_FILE=

# HTTPS 강제 — 인증서 적용(setup_tls_cert.ps1)과 전원 HTTPS 접속 확인 후 on 으로 바꾸면,
# 서버 PC 밖에서 들어오는 평문 HTTP API 요청을 거부한다.
# REQUIRE_HTTPS=on

# 접속기록(감사 로그) — 앱 DB와 분리된 별도 파일에 저장 (기본: 사용자 폴더 .debtflow/audit/audit.db)
# 보관 기간은 정보보안팀/법무팀이 확인한 법정 기준 이상으로 맞출 것 (기본 730일)
# AUDIT_DB_PATH=
# AUDIT_RETENTION_DAYS=730
# 접속기록 무결성(HMAC) 키 — 비우면 접속기록 폴더의 audit.key 파일을 자동 생성해 쓴다. 파일과 분리해 별도 보관할 것.
# AUDIT_HMAC_KEY=
# AUDIT_KEY_FILE=
# 이상 행위 알림 기준(1시간당): 원문 열람 / 다운로드 / 전체 요청 수
# AUDIT_ALERT_REVEALS_PER_HOUR=30
# AUDIT_ALERT_DOWNLOADS_PER_HOUR=20
# AUDIT_ALERT_REQUESTS_PER_HOUR=5000

# 대량 반출 통제 — 목록 다운로드 1회 상한/하루 누적 상한(건), 사용자별 분당 API 호출 상한
# EXPORT_MAX_ROWS=3000
# EXPORT_DAILY_MAX_ROWS=10000
# RATE_LIMIT_PER_MIN=1500
